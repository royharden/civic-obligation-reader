# Browser (Vite) — optional. Without these the app runs keyless with local rulings only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Eval-only names (local Node eval runner; never VITE_-prefixed, never sent to the browser).
# Listed as names only. Do not put values in this file or in the repo; set them in your shell when a run is approved.
#   ANTHROPIC_API_KEY
#   OPENAI_API_KEY
#   MODEL_BASE_URL      (openai_compatible endpoint)
# Model ids and the price edition come from the frozen eval/experiment.json, not from the environment.
